{
  "name": "iidev-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:retention": "wrangler deploy --config wrangler.retention.jsonc",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply iidev-leads --local",
    "db:migrate:remote": "wrangler d1 migrations apply iidev-leads --remote"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@wrksz/themes": "^0.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "libphonenumber-js": "^1.13.12",
    "lucide-react": "^0.554.0",
    "next": "^16.3.3",
    "openai": "^7.8.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@opennextjs/cloudflare": "^1.20.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.10.34",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
